{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StatNext",
  "version": "0.4.2",
  "identifier": "app.statnext.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir frontend dev",
    "beforeBuildCommand": "pnpm --dir frontend build"
  },
  "app": {
    "windows": [
      { "title": "StatNext", "width": 1440, "height": 900, "minWidth": 1024, "minHeight": 640 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; frame-src asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": { "enable": true, "scope": ["$TEMP/**", "$APPDATA/**", "$APPLOCALDATA/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../r-backend": "r-backend",
      "../analyses": "analyses",
      "../datasets": "datasets"
    },
    "category": "Education",
    "shortDescription": "Point-and-click statistics with reproducible R code",
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" }
  }
}
