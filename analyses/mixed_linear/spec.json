{
  "$schema": "../../schemas/module.schema.json",
  "id": "mixed_linear",
  "version": "1.0.0",
  "title": "Linear Mixed Model",
  "description": "Continuous outcome with clustered or repeated data",
  "menu": [
    "Regression",
    "Mixed models"
  ],
  "r": {
    "file": "mixed_linear.R",
    "fn": "codegen_mixed_linear",
    "packages": [
      "lme4",
      "lmerTest",
      "performance",
      "ggnext"
    ]
  },
  "roles": [
    {
      "id": "dv",
      "label": "Dependent variable",
      "min": 1,
      "max": 1,
      "measure": [
        "continuous"
      ]
    },
    {
      "id": "covariates",
      "label": "Covariates (continuous)",
      "min": 0,
      "max": null,
      "measure": [
        "continuous",
        "ordinal"
      ]
    },
    {
      "id": "factors",
      "label": "Factors (categorical)",
      "min": 0,
      "max": null,
      "measure": [
        "nominal",
        "ordinal"
      ],
      "levels": {
        "min": 2
      }
    },
    {
      "id": "cluster",
      "label": "Grouping variable (random intercept)",
      "min": 1,
      "max": 1,
      "measure": [],
      "levels": {
        "min": 2
      }
    }
  ],
  "options": {
    "interactions": {
      "type": "interactions",
      "label": "Interactions",
      "from": [
        "covariates",
        "factors"
      ]
    },
    "random_slopes": {
      "type": "subset",
      "label": "Random slopes for",
      "from": [
        "covariates",
        "factors"
      ]
    },
    "method": {
      "type": "enum",
      "label": "Estimation",
      "values": [
        "REML",
        "ML"
      ],
      "labels": [
        "REML",
        "Maximum likelihood"
      ],
      "default": "REML"
    },
    "conf_level": {
      "type": "number",
      "label": "Confidence level",
      "min": 0.5,
      "max": 0.999,
      "step": 0.01,
      "default": 0.95
    },
    "r2": {
      "type": "bool",
      "label": "R² (marginal and conditional) and ICC",
      "default": true
    },
    "diagnostics": {
      "type": "enum",
      "label": "Assumption checks",
      "values": [
        "normality",
        "singular"
      ],
      "labels": [
        "Normality of residuals (Shapiro-Wilk)",
        "Singular fit"
      ],
      "multiple": true,
      "default": [
        "normality",
        "singular"
      ]
    },
    "plot": {
      "type": "enum",
      "label": "Plots",
      "values": [
        "residuals",
        "qq",
        "coef"
      ],
      "labels": [
        "Residuals vs fitted",
        "Q-Q plot of residuals",
        "Coefficient plot"
      ],
      "multiple": true,
      "default": [
        "residuals"
      ]
    }
  },
  "layout": [
    {
      "section": "Variables",
      "items": [
        "dv",
        "covariates",
        "factors",
        "cluster"
      ]
    },
    {
      "section": "Fixed effects",
      "items": [
        "interactions",
        "conf_level"
      ]
    },
    {
      "section": "Random effects",
      "items": [
        "random_slopes",
        "method",
        "r2"
      ]
    },
    {
      "section": "Assumption checks",
      "items": [
        "diagnostics"
      ],
      "collapsed": true
    },
    {
      "section": "Plots",
      "items": [
        "plot"
      ],
      "collapsed": true
    }
  ],
  "guide": {
    "outcome": "continuous",
    "design": "clustered"
  },
  "example": {
    "dataset": "sleepstudy",
    "options": {
      "dv": [
        "reaction"
      ],
      "covariates": [
        "days"
      ],
      "cluster": [
        "subject"
      ],
      "random_slopes": [
        "days"
      ]
    }
  }
}
