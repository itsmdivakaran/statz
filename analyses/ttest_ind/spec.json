{
  "$schema": "../../schemas/module.schema.json",
  "id": "ttest_ind",
  "version": "1.0.0",
  "title": "Independent Samples T-Test",
  "menu": ["Tests", "T-Tests"],
  "r": { "file": "ttest_ind.R", "fn": "codegen_ttest_ind", "packages": ["effectsize", "car", "ggnext"] },
  "roles": [
    { "id": "dv", "label": "Dependent variables", "min": 1, "max": null, "measure": ["continuous"] },
    { "id": "group", "label": "Grouping variable", "min": 1, "max": 1, "measure": ["nominal", "ordinal"], "levels": { "exactly": 2 } }
  ],
  "options": {
    "test": { "type": "enum", "label": "Tests", "values": ["welch", "student", "mann_whitney"], "labels": ["Welch", "Student", "Mann-Whitney U"], "multiple": true, "default": ["welch"] },
    "alternative": { "type": "enum", "label": "Alternative hypothesis", "values": ["two.sided", "less", "greater"], "labels": ["Group 1 ≠ Group 2", "Group 1 < Group 2", "Group 1 > Group 2"], "default": "two.sided" },
    "conf_level": { "type": "number", "label": "Confidence level", "min": 0.5, "max": 0.999, "step": 0.01, "default": 0.95 },
    "effect_size": { "type": "enum", "label": "Effect size", "values": ["none", "cohens_d", "hedges_g"], "labels": ["None", "Cohen's d", "Hedges' g"], "default": "cohens_d" },
    "descriptives": { "type": "bool", "label": "Group descriptives", "default": true },
    "assumptions": { "type": "enum", "label": "Assumption checks", "values": ["normality", "levene"], "labels": ["Normality (Shapiro-Wilk)", "Equal variances (Levene)"], "multiple": true, "default": ["normality", "levene"] },
    "plot": { "type": "enum", "label": "Plot", "values": ["none", "box_jitter", "violin", "mean_ci"], "labels": ["None", "Box plot + points", "Violin", "Mean ± 95% CI"], "default": "box_jitter" }
  },
  "layout": [
    { "section": "Variables", "items": ["dv", "group"] },
    { "section": "Tests", "items": ["test", "alternative", "conf_level"] },
    { "section": "Additional statistics", "items": ["effect_size", "descriptives"] },
    { "section": "Assumption checks", "items": ["assumptions"], "collapsed": true },
    { "section": "Plots", "items": ["plot"], "collapsed": true }
  ],
  "guide": { "outcome": "continuous", "groups": 2, "design": "independent" },
  "example": { "dataset": "mtcars", "options": { "dv": ["mpg"], "group": ["am"] } }
}
