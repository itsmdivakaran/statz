{
  "$schema": "../../schemas/module.schema.json",
  "id": "meta_generic",
  "version": "1.0.0",
  "title": "Meta-Analysis (Effect Sizes)",
  "description": "Pool effect sizes that come with standard errors",
  "menu": [
    "Clinical",
    "Meta-analysis"
  ],
  "r": {
    "file": "meta_generic.R",
    "fn": "codegen_meta_generic",
    "packages": [
      "metafor",
      "ggnext"
    ]
  },
  "roles": [
    {
      "id": "study",
      "label": "Study label (optional)",
      "min": 0,
      "max": 1,
      "measure": []
    },
    {
      "id": "effect",
      "label": "Effect size",
      "min": 1,
      "max": 1,
      "measure": [
        "continuous"
      ]
    },
    {
      "id": "se",
      "label": "Standard error",
      "min": 1,
      "max": 1,
      "measure": [
        "continuous"
      ]
    },
    {
      "id": "moderator",
      "label": "Moderator (optional)",
      "min": 0,
      "max": 1,
      "measure": []
    }
  ],
  "options": {
    "scale": {
      "type": "enum",
      "label": "Effect sizes are",
      "values": [
        "identity",
        "log"
      ],
      "labels": [
        "On their natural scale (e.g. mean difference, SMD)",
        "Log ratios (report as ratios)"
      ],
      "default": "identity"
    },
    "model": {
      "type": "enum",
      "label": "Model",
      "values": [
        "random",
        "fixed"
      ],
      "labels": [
        "Random effects",
        "Common (fixed) effect"
      ],
      "default": "random"
    },
    "tau2": {
      "type": "enum",
      "label": "Between-study variance (τ²)",
      "values": [
        "REML",
        "DL",
        "PM"
      ],
      "labels": [
        "REML",
        "DerSimonian-Laird",
        "Paule-Mandel"
      ],
      "default": "REML"
    },
    "knha": {
      "type": "bool",
      "label": "Hartung-Knapp adjustment",
      "default": false
    },
    "conf_level": {
      "type": "number",
      "label": "Confidence level",
      "min": 0.5,
      "max": 0.999,
      "step": 0.01,
      "default": 0.95
    },
    "prediction": {
      "type": "bool",
      "label": "Prediction interval",
      "default": true
    },
    "egger": {
      "type": "bool",
      "label": "Egger's test for funnel asymmetry",
      "default": true
    },
    "trimfill": {
      "type": "bool",
      "label": "Trim and fill",
      "default": false
    },
    "leave1out": {
      "type": "bool",
      "label": "Leave-one-out sensitivity",
      "default": false
    },
    "plot": {
      "type": "enum",
      "label": "Plots",
      "values": [
        "forest",
        "funnel"
      ],
      "labels": [
        "Forest plot",
        "Funnel plot"
      ],
      "multiple": true,
      "default": [
        "forest",
        "funnel"
      ]
    }
  },
  "layout": [
    {
      "section": "Variables",
      "items": [
        "study",
        "effect",
        "se",
        "moderator"
      ]
    },
    {
      "section": "Model",
      "items": [
        "scale",
        "model",
        "tau2",
        "knha",
        "conf_level",
        "prediction"
      ]
    },
    {
      "section": "Bias and sensitivity",
      "items": [
        "egger",
        "trimfill",
        "leave1out"
      ],
      "collapsed": true
    },
    {
      "section": "Plots",
      "items": [
        "plot"
      ],
      "collapsed": true
    }
  ],
  "guide": {
    "outcome": "effect-size",
    "design": "meta-analysis"
  },
  "example": {
    "dataset": "bcg",
    "options": {
      "study": [
        "study"
      ],
      "effect": [
        "log_rr"
      ],
      "se": [
        "se"
      ],
      "scale": "log"
    }
  }
}
