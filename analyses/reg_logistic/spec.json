{
  "$schema": "../../schemas/module.schema.json",
  "id": "reg_logistic",
  "version": "1.0.0",
  "title": "Logistic Regression",
  "description": "Binary outcome, odds ratios, ROC curve",
  "menu": [
    "Regression",
    "Generalized linear models"
  ],
  "r": {
    "file": "reg_logistic.R",
    "fn": "codegen_reg_logistic",
    "packages": [
      "car",
      "ggnext"
    ]
  },
  "roles": [
    {
      "id": "dv",
      "label": "Dependent variable (2 categories)",
      "min": 1,
      "max": 1,
      "measure": [
        "nominal",
        "ordinal"
      ],
      "levels": {
        "exactly": 2
      }
    },
    {
      "id": "covariates",
      "label": "Covariates (continuous)",
      "min": 0,
      "max": null,
      "measure": [
        "continuous",
        "ordinal"
      ]
    },
    {
      "id": "factors",
      "label": "Factors (categorical)",
      "min": 0,
      "max": null,
      "measure": [
        "nominal",
        "ordinal"
      ],
      "levels": {
        "min": 2
      }
    }
  ],
  "options": {
    "interactions": {
      "type": "interactions",
      "label": "Interactions",
      "from": [
        "covariates",
        "factors"
      ]
    },
    "conf_level": {
      "type": "number",
      "label": "Confidence level",
      "min": 0.5,
      "max": 0.999,
      "step": 0.01,
      "default": 0.95
    },
    "classification": {
      "type": "bool",
      "label": "Classification table",
      "default": true
    },
    "diagnostics": {
      "type": "enum",
      "label": "Assumption checks",
      "values": [
        "vif",
        "hl"
      ],
      "labels": [
        "Multicollinearity (VIF)",
        "Calibration (Hosmer-Lemeshow)"
      ],
      "multiple": true,
      "default": [
        "vif",
        "hl"
      ]
    },
    "plot": {
      "type": "enum",
      "label": "Plots",
      "values": [
        "roc",
        "coef"
      ],
      "labels": [
        "ROC curve",
        "Coefficient plot (log odds)"
      ],
      "multiple": true,
      "default": [
        "roc"
      ]
    }
  },
  "layout": [
    {
      "section": "Variables",
      "items": [
        "dv",
        "covariates",
        "factors"
      ]
    },
    {
      "section": "Model",
      "items": [
        "interactions",
        "conf_level",
        "classification"
      ]
    },
    {
      "section": "Assumption checks",
      "items": [
        "diagnostics"
      ],
      "collapsed": true
    },
    {
      "section": "Plots",
      "items": [
        "plot"
      ],
      "collapsed": true
    }
  ],
  "guide": {
    "outcome": "binary",
    "design": "regression"
  },
  "example": {
    "dataset": "infert",
    "options": {
      "dv": [
        "case"
      ],
      "covariates": [
        "age",
        "parity"
      ],
      "factors": [
        "spontaneous",
        "induced"
      ]
    }
  }
}
