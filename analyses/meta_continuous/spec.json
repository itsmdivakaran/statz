{
  "$schema": "../../schemas/module.schema.json",
  "id": "meta_continuous",
  "version": "1.0.0",
  "title": "Meta-Analysis (Continuous Outcomes)",
  "description": "Pool mean differences from group means and SDs",
  "menu": [
    "Clinical",
    "Meta-analysis"
  ],
  "r": {
    "file": "meta_continuous.R",
    "fn": "codegen_meta_continuous",
    "packages": [
      "metafor",
      "ggnext"
    ]
  },
  "roles": [
    {
      "id": "study",
      "label": "Study label (optional)",
      "min": 0,
      "max": 1,
      "measure": []
    },
    {
      "id": "n1",
      "label": "Sample size, group 1",
      "min": 1,
      "max": 1,
      "measure": [
        "continuous"
      ]
    },
    {
      "id": "mean1",
      "label": "Mean, group 1",
      "min": 1,
      "max": 1,
      "measure": [
        "continuous"
      ]
    },
    {
      "id": "sd1",
      "label": "SD, group 1",
      "min": 1,
      "max": 1,
      "measure": [
        "continuous"
      ]
    },
    {
      "id": "n2",
      "label": "Sample size, group 2",
      "min": 1,
      "max": 1,
      "measure": [
        "continuous"
      ]
    },
    {
      "id": "mean2",
      "label": "Mean, group 2",
      "min": 1,
      "max": 1,
      "measure": [
        "continuous"
      ]
    },
    {
      "id": "sd2",
      "label": "SD, group 2",
      "min": 1,
      "max": 1,
      "measure": [
        "continuous"
      ]
    },
    {
      "id": "moderator",
      "label": "Moderator (optional)",
      "min": 0,
      "max": 1,
      "measure": []
    }
  ],
  "options": {
    "measure": {
      "type": "enum",
      "label": "Effect measure",
      "values": [
        "SMD",
        "MD"
      ],
      "labels": [
        "Standardized mean difference (Hedges' g)",
        "Mean difference"
      ],
      "default": "SMD"
    },
    "model": {
      "type": "enum",
      "label": "Model",
      "values": [
        "random",
        "fixed"
      ],
      "labels": [
        "Random effects",
        "Common (fixed) effect"
      ],
      "default": "random"
    },
    "tau2": {
      "type": "enum",
      "label": "Between-study variance (τ²)",
      "values": [
        "REML",
        "DL",
        "PM"
      ],
      "labels": [
        "REML",
        "DerSimonian-Laird",
        "Paule-Mandel"
      ],
      "default": "REML"
    },
    "knha": {
      "type": "bool",
      "label": "Hartung-Knapp adjustment",
      "default": false
    },
    "conf_level": {
      "type": "number",
      "label": "Confidence level",
      "min": 0.5,
      "max": 0.999,
      "step": 0.01,
      "default": 0.95
    },
    "prediction": {
      "type": "bool",
      "label": "Prediction interval",
      "default": true
    },
    "egger": {
      "type": "bool",
      "label": "Egger's test for funnel asymmetry",
      "default": true
    },
    "trimfill": {
      "type": "bool",
      "label": "Trim and fill",
      "default": false
    },
    "leave1out": {
      "type": "bool",
      "label": "Leave-one-out sensitivity",
      "default": false
    },
    "plot": {
      "type": "enum",
      "label": "Plots",
      "values": [
        "forest",
        "funnel"
      ],
      "labels": [
        "Forest plot",
        "Funnel plot"
      ],
      "multiple": true,
      "default": [
        "forest",
        "funnel"
      ]
    }
  },
  "layout": [
    {
      "section": "Variables",
      "items": [
        "study",
        "n1",
        "mean1",
        "sd1",
        "n2",
        "mean2",
        "sd2",
        "moderator"
      ]
    },
    {
      "section": "Model",
      "items": [
        "measure",
        "model",
        "tau2",
        "knha",
        "conf_level",
        "prediction"
      ]
    },
    {
      "section": "Bias and sensitivity",
      "items": [
        "egger",
        "trimfill",
        "leave1out"
      ],
      "collapsed": true
    },
    {
      "section": "Plots",
      "items": [
        "plot"
      ],
      "collapsed": true
    }
  ],
  "guide": {
    "outcome": "effect-size",
    "design": "meta-analysis"
  },
  "example": {
    "dataset": "stroke_los",
    "options": {
      "study": [
        "study"
      ],
      "n1": [
        "n_stroke_unit"
      ],
      "mean1": [
        "mean_stroke_unit"
      ],
      "sd1": [
        "sd_stroke_unit"
      ],
      "n2": [
        "n_usual"
      ],
      "mean2": [
        "mean_usual"
      ],
      "sd2": [
        "sd_usual"
      ],
      "measure": "MD"
    }
  }
}
