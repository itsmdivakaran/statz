{
  "$schema": "../../schemas/module.schema.json",
  "id": "ttest_paired",
  "version": "1.0.0",
  "title": "Paired Samples T-Test",
  "menu": ["Tests", "T-Tests"],
  "r": { "file": "ttest_paired.R", "fn": "codegen_ttest_paired", "packages": ["effectsize", "ggnext"] },
  "roles": [
    { "id": "var1", "label": "Measure 1", "min": 1, "max": 1, "measure": ["continuous"] },
    { "id": "var2", "label": "Measure 2", "min": 1, "max": 1, "measure": ["continuous"] }
  ],
  "options": {
    "test": { "type": "enum", "label": "Tests", "values": ["student", "wilcoxon"], "labels": ["Student", "Wilcoxon signed-rank"], "multiple": true, "default": ["student"] },
    "alternative": { "type": "enum", "label": "Alternative hypothesis", "values": ["two.sided", "less", "greater"], "labels": ["Measure 1 ≠ Measure 2", "Measure 1 < Measure 2", "Measure 1 > Measure 2"], "default": "two.sided" },
    "conf_level": { "type": "number", "label": "Confidence level", "min": 0.5, "max": 0.999, "step": 0.01, "default": 0.95 },
    "effect_size": { "type": "enum", "label": "Effect size", "values": ["none", "cohens_dz"], "labels": ["None", "Cohen's dz"], "default": "cohens_dz" },
    "descriptives": { "type": "bool", "label": "Descriptives", "default": true },
    "assumptions": { "type": "enum", "label": "Assumption checks", "values": ["normality"], "labels": ["Normality of differences (Shapiro-Wilk)"], "multiple": true, "default": ["normality"] },
    "plot": { "type": "enum", "label": "Plot", "values": ["none", "histogram", "qq"], "labels": ["None", "Histogram of differences", "Q-Q plot of differences"], "default": "histogram" }
  },
  "layout": [
    { "section": "Variables", "items": ["var1", "var2"] },
    { "section": "Tests", "items": ["test", "alternative", "conf_level"] },
    { "section": "Additional statistics", "items": ["effect_size", "descriptives"] },
    { "section": "Assumption checks", "items": ["assumptions"], "collapsed": true },
    { "section": "Plots", "items": ["plot"], "collapsed": true }
  ],
  "guide": { "outcome": "continuous", "groups": 2, "design": "paired" },
  "example": { "dataset": "sleep_wide", "options": { "var1": ["drug1"], "var2": ["drug2"] } }
}
