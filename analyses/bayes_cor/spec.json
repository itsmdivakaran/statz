{
  "$schema": "../../schemas/module.schema.json",
  "id": "bayes_cor",
  "version": "1.0.0",
  "title": "Bayesian Correlation",
  "description": "Evidence for or against a correlation between pairs of variables",
  "menu": [
    "Bayesian",
    "Correlation"
  ],
  "r": {
    "file": "bayes_cor.R",
    "fn": "codegen_bayes_cor",
    "packages": [
      "BayesFactor",
      "ggnext"
    ]
  },
  "roles": [
    {
      "id": "vars",
      "label": "Variables",
      "min": 2,
      "max": null,
      "measure": [
        "continuous"
      ]
    }
  ],
  "options": {
    "alternative": {
      "type": "enum",
      "label": "Alternative hypothesis",
      "values": [
        "two.sided",
        "greater",
        "less"
      ],
      "labels": [
        "Correlated",
        "Positively correlated",
        "Negatively correlated"
      ],
      "default": "two.sided"
    },
    "prior": {
      "type": "enum",
      "label": "Prior width",
      "values": [
        "medium",
        "wide",
        "ultrawide",
        "custom"
      ],
      "labels": [
        "Medium (width 1/3)",
        "Wide (width 0.577)",
        "Ultrawide (width 1)",
        "Custom"
      ],
      "default": "medium"
    },
    "prior_r": {
      "type": "number",
      "label": "Custom prior width",
      "min": 0.01,
      "max": 1,
      "step": 0.05,
      "default": 0.333
    },
    "bf_type": {
      "type": "enum",
      "label": "Bayes factor",
      "values": [
        "bf10",
        "bf01",
        "log_bf10"
      ],
      "labels": [
        "BF₁₀ (evidence for H₁)",
        "BF₀₁ (evidence for H₀)",
        "log(BF₁₀)"
      ],
      "default": "bf10"
    },
    "posterior": {
      "type": "bool",
      "label": "Posterior ρ and credible interval",
      "default": true
    },
    "ci_level": {
      "type": "number",
      "label": "Credible interval",
      "min": 0.5,
      "max": 0.999,
      "step": 0.01,
      "default": 0.95
    },
    "plot": {
      "type": "enum",
      "label": "Plot",
      "values": [
        "none",
        "scatter",
        "prior_posterior"
      ],
      "labels": [
        "None",
        "Scatter plot (first pair)",
        "Prior and posterior of ρ (first pair)"
      ],
      "default": "scatter"
    },
    "seed": {
      "type": "number",
      "label": "Random seed",
      "min": 1,
      "max": 999999,
      "step": 1,
      "default": 123
    }
  },
  "layout": [
    {
      "section": "Variables",
      "items": [
        "vars"
      ]
    },
    {
      "section": "Hypothesis",
      "items": [
        "alternative"
      ]
    },
    {
      "section": "Prior",
      "items": [
        "prior",
        "prior_r"
      ]
    },
    {
      "section": "Output",
      "items": [
        "bf_type",
        "posterior",
        "ci_level"
      ]
    },
    {
      "section": "Plots",
      "items": [
        "plot"
      ],
      "collapsed": true
    },
    {
      "section": "Advanced",
      "items": [
        "seed"
      ],
      "collapsed": true
    }
  ],
  "guide": {
    "outcome": "continuous",
    "design": "association",
    "bayesian": true
  },
  "example": {
    "dataset": "mtcars",
    "options": {
      "vars": [
        "mpg",
        "wt",
        "qsec"
      ]
    }
  }
}
