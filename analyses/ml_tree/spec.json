{
  "$schema": "../../schemas/module.schema.json",
  "id": "ml_tree",
  "version": "1.0.0",
  "title": "Decision Tree",
  "description": "Classification or regression tree (CART)",
  "menu": [
    "Machine Learning",
    "Classification and regression"
  ],
  "r": {
    "file": "ml_tree.R",
    "fn": "codegen_ml_tree",
    "packages": [
      "rpart",
      "pROC",
      "ggnext"
    ]
  },
  "roles": [
    {
      "id": "outcome",
      "label": "Outcome (categorical or numeric)",
      "min": 1,
      "max": 1,
      "measure": []
    },
    {
      "id": "covariates",
      "label": "Numeric predictors",
      "min": 0,
      "max": null,
      "measure": [
        "continuous",
        "ordinal"
      ]
    },
    {
      "id": "factors",
      "label": "Categorical predictors",
      "min": 0,
      "max": null,
      "measure": [
        "nominal",
        "ordinal"
      ]
    }
  ],
  "options": {
    "task": {
      "type": "enum",
      "label": "Task",
      "values": [
        "auto",
        "classification",
        "regression"
      ],
      "labels": [
        "Detect from the outcome",
        "Classification",
        "Regression"
      ],
      "default": "auto"
    },
    "cp": {
      "type": "number",
      "label": "Complexity parameter (cp)",
      "min": 0,
      "max": 1,
      "step": 0.001,
      "default": 0.01
    },
    "maxdepth": {
      "type": "number",
      "label": "Maximum depth",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 5
    },
    "minsplit": {
      "type": "number",
      "label": "Minimum cases to split a node",
      "min": 2,
      "max": 1000,
      "step": 1,
      "default": 20
    },
    "prune": {
      "type": "bool",
      "label": "Prune to the lowest cross-validated error",
      "default": false
    },
    "tree_plot": {
      "type": "bool",
      "label": "Tree diagram",
      "default": true
    },
    "test_size": {
      "type": "number",
      "label": "Test set (% of cases held out)",
      "min": 10,
      "max": 50,
      "step": 5,
      "default": 25
    },
    "seed": {
      "type": "number",
      "label": "Random seed",
      "min": 1,
      "max": 999999,
      "step": 1,
      "default": 123
    },
    "importance": {
      "type": "bool",
      "label": "Variable importance",
      "default": true
    },
    "shap": {
      "type": "bool",
      "label": "SHAP values (numeric or two-class outcome)",
      "default": false
    },
    "plot": {
      "type": "enum",
      "label": "Plots",
      "values": [
        "performance",
        "importance"
      ],
      "labels": [
        "Performance (ROC, confusion matrix or observed vs predicted)",
        "Variable importance"
      ],
      "default": [
        "performance",
        "importance"
      ],
      "multiple": true
    }
  },
  "layout": [
    {
      "section": "Variables",
      "items": [
        "outcome",
        "covariates",
        "factors"
      ]
    },
    {
      "section": "Model",
      "items": [
        "task",
        "cp",
        "maxdepth",
        "minsplit",
        "prune",
        "tree_plot"
      ]
    },
    {
      "section": "Validation",
      "items": [
        "test_size",
        "seed"
      ]
    },
    {
      "section": "Explain",
      "items": [
        "importance",
        "shap"
      ]
    },
    {
      "section": "Plots",
      "items": [
        "plot"
      ],
      "collapsed": true
    }
  ],
  "guide": {
    "outcome": "any",
    "design": "prediction"
  },
  "example": {
    "dataset": "iris",
    "options": {
      "outcome": [
        "species"
      ],
      "covariates": [
        "sepal_length",
        "sepal_width",
        "petal_length",
        "petal_width"
      ]
    }
  }
}
