{
  "$schema": "../../schemas/module.schema.json",
  "id": "clin_ae",
  "version": "1.0.0",
  "title": "Adverse Events Table",
  "description": "Subjects with each adverse event by treatment arm",
  "menu": ["Clinical", "Clinical tables"],
  "r": { "file": "clin_ae.R", "fn": "codegen_clin_ae", "packages": ["ggnext"] },
  "roles": [
    { "id": "subject", "label": "Subject identifier", "min": 1, "max": 1, "measure": [] },
    { "id": "arm", "label": "Treatment arm", "min": 1, "max": 1, "measure": [] },
    { "id": "term", "label": "Adverse event term", "min": 1, "max": 1, "measure": [] },
    { "id": "soc", "label": "System organ class (optional)", "min": 0, "max": 1, "measure": [] },
    { "id": "severity", "label": "Severity (optional)", "min": 0, "max": 1, "measure": [] }
  ],
  "options": {
    "arm_n": { "type": "text", "label": "Subjects per arm (first arm = reference)", "default": "", "placeholder": "e.g. Placebo=85, Drug=84" },
    "min_pct": { "type": "number", "label": "Show events with at least this % in any arm", "min": 0, "max": 100, "step": 1, "default": 0 },
    "compare": { "type": "bool", "label": "Risk difference versus the first arm", "default": true },
    "conf_level": { "type": "number", "label": "Confidence level", "min": 0.5, "max": 0.999, "step": 0.01, "default": 0.95 },
    "plot": { "type": "enum", "label": "Plot", "values": ["none", "heatmap"], "labels": ["None", "Incidence heatmap"], "default": "heatmap" }
  },
  "layout": [
    { "section": "Variables", "items": ["subject", "arm", "term", "soc", "severity"] },
    { "section": "Options", "items": ["arm_n", "min_pct", "compare", "conf_level"] },
    { "section": "Plots", "items": ["plot"], "collapsed": true }
  ],
  "guide": { "outcome": "binary", "design": "safety" },
  "example": { "dataset": "adae_sim", "options": { "subject": ["USUBJID"], "arm": ["TRT01P"], "term": ["AEDECOD"], "soc": ["AEBODSYS"], "severity": ["AESEV"], "arm_n": "Placebo=85, Drug 54 mg=85, Drug 81 mg=84" } }
}
