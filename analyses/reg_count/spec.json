{
  "$schema": "../../schemas/module.schema.json",
  "id": "reg_count",
  "version": "1.0.0",
  "title": "Count Regression",
  "description": "Poisson and negative binomial models, rate ratios",
  "menu": [
    "Regression",
    "Generalized linear models"
  ],
  "r": {
    "file": "reg_count.R",
    "fn": "codegen_reg_count",
    "packages": [
      "MASS",
      "ggnext"
    ]
  },
  "roles": [
    {
      "id": "dv",
      "label": "Dependent variable (count)",
      "min": 1,
      "max": 1,
      "measure": [
        "continuous"
      ]
    },
    {
      "id": "covariates",
      "label": "Covariates (continuous)",
      "min": 0,
      "max": null,
      "measure": [
        "continuous",
        "ordinal"
      ]
    },
    {
      "id": "factors",
      "label": "Factors (categorical)",
      "min": 0,
      "max": null,
      "measure": [
        "nominal",
        "ordinal"
      ],
      "levels": {
        "min": 2
      }
    },
    {
      "id": "exposure",
      "label": "Exposure (offset)",
      "min": 0,
      "max": 1,
      "measure": [
        "continuous"
      ]
    }
  ],
  "options": {
    "interactions": {
      "type": "interactions",
      "label": "Interactions",
      "from": [
        "covariates",
        "factors"
      ]
    },
    "conf_level": {
      "type": "number",
      "label": "Confidence level",
      "min": 0.5,
      "max": 0.999,
      "step": 0.01,
      "default": 0.95
    },
    "family": {
      "type": "enum",
      "label": "Model",
      "values": [
        "poisson",
        "quasipoisson",
        "negbin"
      ],
      "labels": [
        "Poisson",
        "Quasi-Poisson",
        "Negative binomial"
      ],
      "default": "poisson"
    },
    "diagnostics": {
      "type": "enum",
      "label": "Assumption checks",
      "values": [
        "dispersion"
      ],
      "labels": [
        "Overdispersion"
      ],
      "multiple": true,
      "default": [
        "dispersion"
      ]
    },
    "plot": {
      "type": "enum",
      "label": "Plots",
      "values": [
        "residuals",
        "coef"
      ],
      "labels": [
        "Residuals vs fitted",
        "Coefficient plot (log rate)"
      ],
      "multiple": true,
      "default": [
        "residuals"
      ]
    }
  },
  "layout": [
    {
      "section": "Variables",
      "items": [
        "dv",
        "covariates",
        "factors",
        "exposure"
      ]
    },
    {
      "section": "Model",
      "items": [
        "interactions",
        "conf_level",
        "family"
      ]
    },
    {
      "section": "Assumption checks",
      "items": [
        "diagnostics"
      ],
      "collapsed": true
    },
    {
      "section": "Plots",
      "items": [
        "plot"
      ],
      "collapsed": true
    }
  ],
  "guide": {
    "outcome": "count",
    "design": "regression"
  },
  "example": {
    "dataset": "quine",
    "options": {
      "dv": [
        "days"
      ],
      "factors": [
        "ethnicity",
        "sex",
        "age",
        "learner"
      ],
      "family": "negbin"
    }
  }
}
