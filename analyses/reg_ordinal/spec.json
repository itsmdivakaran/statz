{
  "$schema": "../../schemas/module.schema.json",
  "id": "reg_ordinal",
  "version": "1.0.0",
  "title": "Ordinal Regression",
  "description": "Ordered outcome, proportional odds model",
  "menu": [
    "Regression",
    "Generalized linear models"
  ],
  "r": {
    "file": "reg_ordinal.R",
    "fn": "codegen_reg_ordinal",
    "packages": [
      "MASS",
      "nnet"
    ]
  },
  "roles": [
    {
      "id": "dv",
      "label": "Dependent variable (ordered categories)",
      "min": 1,
      "max": 1,
      "measure": [
        "ordinal",
        "nominal"
      ],
      "levels": {
        "min": 3
      }
    },
    {
      "id": "covariates",
      "label": "Covariates (continuous)",
      "min": 0,
      "max": null,
      "measure": [
        "continuous",
        "ordinal"
      ]
    },
    {
      "id": "factors",
      "label": "Factors (categorical)",
      "min": 0,
      "max": null,
      "measure": [
        "nominal",
        "ordinal"
      ],
      "levels": {
        "min": 2
      }
    }
  ],
  "options": {
    "interactions": {
      "type": "interactions",
      "label": "Interactions",
      "from": [
        "covariates",
        "factors"
      ]
    },
    "conf_level": {
      "type": "number",
      "label": "Confidence level",
      "min": 0.5,
      "max": 0.999,
      "step": 0.01,
      "default": 0.95
    },
    "diagnostics": {
      "type": "enum",
      "label": "Assumption checks",
      "values": [
        "parallel"
      ],
      "labels": [
        "Proportional odds (compare with multinomial model)"
      ],
      "multiple": true,
      "default": [
        "parallel"
      ]
    }
  },
  "layout": [
    {
      "section": "Variables",
      "items": [
        "dv",
        "covariates",
        "factors"
      ]
    },
    {
      "section": "Model",
      "items": [
        "interactions",
        "conf_level"
      ]
    },
    {
      "section": "Assumption checks",
      "items": [
        "diagnostics"
      ],
      "collapsed": true
    }
  ],
  "guide": {
    "outcome": "ordinal",
    "design": "regression"
  },
  "example": {
    "dataset": "housing",
    "options": {
      "dv": [
        "satisfaction"
      ],
      "factors": [
        "influence",
        "type",
        "contact"
      ]
    }
  }
}
