  "module": "reg_linear",
  "module_version": "1.0.0",
  "title": "Linear Regression",
  "status": "ok",
  "code": "library(car)\nlibrary(ggnext)\n# Linear regression: mpg on wt, hp, am\nd <- data[complete.cases(data[, c(\"mpg\", \"wt\", \"hp\", \"am\"), drop = FALSE]), , drop = FALSE]\nd$am <- factor(d$am, levels = c(0, 1), labels = c(\"Automatic\", \"Manual\"))\nfit <- lm(mpg ~ wt + hp + am, data = d)\ncoefs <- cbind(coef(summary(fit)), confint(fit, level = 0.95))\n# Standardized coefficients: refit with the outcome and continuous predictors scaled\nd_std <- d; num <- c(\"mpg\", \"wt\", \"hp\")\nd_std[num] <- lapply(d_std[num], function(v) as.numeric(scale(v)))\nstd_beta <- coef(update(fit, data = d_std))\nfit_summary <- summary(fit)\nvif_values <- vif(fit)\nnormality <- shapiro.test(residuals(fit))\nbp <- ncvTest(fit)\ncooks <- cooks.distance(fit)\nresid_df <- data.frame(fitted = fitted(fit), resid = residuals(fit))\np_resid <- ggnext(resid_df, aes(fitted, resid)) +\n  geom_residual() +\n  labs(title = \"Residuals vs fitted\", x = \"Fitted values\", y = \"Residuals\") +\n  theme_modern()\np_qq <- ggnext(resid_df, aes(sample = resid)) +\n  geom_qq() +\n  geom_qq_line() +\n  labs(title = \"Normal Q-Q plot of residuals\", x = \"Theoretical quantiles\", y = \"Sample quantiles\") +\n  theme_modern()",
  "warnings": [],
