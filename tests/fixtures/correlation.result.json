  "title": "Correlation",
  "status": "ok",
  "code": "library(ggnext)\n# Pearson correlation: mpg, hp, wt, qsec\nvars <- c(\"mpg\", \"hp\", \"wt\", \"qsec\")\nd <- data[complete.cases(data[, vars]), ]\nx <- d[vars]\ncor_matrix <- cor(x, method = \"pearson\")\npair_idx <- t(combn(vars, 2))\ncor_pairs <- do.call(rbind, lapply(seq_len(nrow(pair_idx)), function(i) {\n  ct <- cor.test(x[[pair_idx[i, 1]]], x[[pair_idx[i, 2]]], method = \"pearson\", conf.level = 0.95, exact = FALSE)\n  ci <- if (is.null(ct$conf.int)) c(NA, NA) else ct$conf.int\n  data.frame(var1 = pair_idx[i, 1], var2 = pair_idx[i, 2], r = unname(ct$estimate), statistic = unname(ct$statistic),\n             df = if (is.null(ct$parameter)) NA else unname(ct$parameter), p = ct$p.value, lower = ci[1], upper = ci[2])\n}))\np <- ggnext() +\n  geom_cor(x, vars = vars) +\n  labs(title = \"Correlation matrix\") +\n  theme_modern()",
