  "module_version": "1.0.0",
  "title": "Multinomial Regression",
  "status": "ok",
  "code": "library(nnet)\n# Multinomial regression: satisfaction on influence, contact\nd <- data[complete.cases(data[, c(\"satisfaction\", \"influence\", \"contact\"), drop = FALSE]), , drop = FALSE]\nd$satisfaction <- factor(d$satisfaction, levels = c(1, 2, 3), labels = c(\"Low\", \"Medium\", \"High\"))\nd$influence <- droplevels(factor(d$influence))\nd$contact <- droplevels(factor(d$contact))\nfit <- multinom(satisfaction ~ influence + contact, data = d, trace = FALSE)\ns <- summary(fit)\n# One row per outcome category (vs the first) and term\ncoefs <- do.call(rbind, lapply(rownames(s$coefficients), function(lv) {\n  b <- s$coefficients[lv, ]; se <- s$standard.errors[lv, ]\n  data.frame(outcome = lv, term = names(b), estimate = b, se = se, z = b / se, p = 2 * pnorm(abs(b / se), lower.tail = FALSE),\n             lower = b - qnorm(1 - (1 - 0.95) / 2) * se, upper = b + qnorm(1 - (1 - 0.95) / 2) * se, row.names = NULL)\n}))\nnull <- multinom(satisfaction ~ 1, data = d, trace = FALSE)\nlr_chi <- deviance(null) - deviance(fit); lr_df <- fit$edf - null$edf\nr2_mcfadden <- 1 - deviance(fit) / deviance(null)\nclass_table <- table(Observed = d$satisfaction, Predicted = predict(fit))",
