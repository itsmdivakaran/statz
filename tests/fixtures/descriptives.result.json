  "code": "library()\n# Descriptive statistics\nd <- data\nd$cyl <- droplevels(factor(d$cyl))\ndesc_stats <- function(x) {\n  v <- x[!is.na(x)]\n  c(n = length(v),\n    missing = sum(is.na(x)),\n    mean = mean(v),\n    sd = sd(v),\n    median = median(v),\n    min = min(v),\n    max = max(v))\n}\ndesc <- sapply(d[c(\"mpg\", \"hp\")], desc_stats)\nfreq <- lapply(d[\"cyl\"], table, useNA = \"ifany\")",
