  "title": "Wilcoxon Signed-Rank Test",
  "status": "ok",
  "code": "library(effectsize)\nlibrary(ggnext)\n# Paired non-parametric tests: drug1 vs drug2\nd <- data[complete.cases(data[, c(\"drug1\", \"drug2\")]), ]\nd$difference <- d$drug1 - d$drug2\ndesc <- sapply(d[, c(\"drug1\", \"drug2\", \"difference\")], function(v)\n  c(n = length(v), median = median(v), q1 = unname(quantile(v, 0.25)), q3 = unname(quantile(v, 0.75))))\nwilcoxon <- wilcox.test(d$drug1, d$drug2, paired = TRUE, alternative = \"two.sided\",\n  conf.int = TRUE, conf.level = 0.95, exact = FALSE)\nrb <- rank_biserial(d$drug1, d$drug2, paired = TRUE, ci = 0.95)\nlong <- data.frame(measurement = factor(rep(c(\"drug1\", \"drug2\"), each = nrow(d)), levels = c(\"drug1\", \"drug2\")),\n  value = c(d$drug1, d$drug2))\np <- ggnext(long, aes(measurement, value)) +\n  geom_boxplot() +\n  geom_jitter(width = 0.15, alpha = 0.7) +\n  labs(title = \"drug1 and drug2\", x = \"Measurement\", y = \"Value\") +\n  theme_modern()",
