  "module": "reg_logistic",
  "module_version": "1.0.0",
  "title": "Logistic Regression",
  "status": "ok",
  "code": "library(car)\nlibrary(ggnext)\n# Logistic regression: case on age, parity, spontaneous, induced\nd <- data[complete.cases(data[, c(\"case\", \"age\", \"parity\", \"spontaneous\", \"induced\"), drop = FALSE]), , drop = FALSE]\nd$case <- factor(d$case, levels = c(0, 1), labels = c(\"Control\", \"Case\"))\nd$spontaneous <- factor(d$spontaneous, levels = c(0, 1, 2), labels = c(\"0\", \"1\", \"2 or more\"))\nd$induced <- factor(d$induced, levels = c(0, 1, 2), labels = c(\"0\", \"1\", \"2 or more\"))\n# Models the probability of the second category: levels(d$case)[2]\nfit <- glm(case ~ age + parity + spontaneous + induced, data = d, family = binomial)\ncoefs <- cbind(coef(summary(fit)), confint.default(fit, level = 0.95))\nn <- nobs(fit)\nlr_chi <- fit$null.deviance - fit$deviance; lr_df <- fit$df.null - fit$df.residual\nr2_mcfadden <- 1 - fit$deviance / fit$null.deviance\nr2_nagelkerke <- (1 - exp((fit$deviance - fit$null.deviance) / n)) / (1 - exp(-fit$null.deviance / n))\npred <- fitted(fit); y <- as.integer(fit$y)\nauc <- (mean(rank(pred)[y == 1]) - (sum(y == 1) + 1) / 2) / sum(y == 0)\nclass_table <- table(Observed = d$case, Predicted = factor(pred >= 0.5, c(FALSE, TRUE), levels(d$case)))\nvif_values <- vif(fit)\n# Hosmer-Lemeshow test with 10 groups of predicted risk\nhl_group <- cut(pred, breaks = unique(quantile(pred, 0:10 / 10)), include.lowest = TRUE)\nhl_obs <- tapply(y, hl_group, sum); hl_exp <- tapply(pred, hl_group, sum); hl_n <- tapply(y, hl_group, length)\nhl_stat <- sum((hl_obs - hl_exp)^2 / (hl_exp * (1 - hl_exp / hl_n)))\nhl_df <- length(hl_obs) - 2; hl_p <- pchisq(hl_stat, hl_df, lower.tail = FALSE)\nroc_df <- data.frame(truth = d$case, score = pred)\np_roc <- ggnext(roc_df, aes(truth = truth, score = score)) +\n  geom_roc() +\n  labs(title = \"ROC curve\", x = \"1 − Specificity\", y = \"Sensitivity\") +\n  theme_modern()",
