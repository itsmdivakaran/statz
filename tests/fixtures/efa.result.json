  "interpretation": {
    "auto_generated": true,
    "text": "An exploratory factor analysis of 25 items (N = 2436) extracted 5 factors, which together explained 42.4% of the variance. Model fit was acceptable (RMSEA = 0.055, TLI = 0.877)."
  },
  "notes": [],
  "module": "efa",
  "module_version": "1.0.0",
  "title": "Exploratory Factor Analysis",
  "status": "ok",
  "code": "library(ggnext)\n# Exploratory factor analysis: 5 factors, minres extraction, oblimin rotation\nvars <- c(\"A1\", \"A2\", \"A3\", \"A4\", \"A5\", \"C1\", \"C2\", \"C3\", \"C4\", \"C5\", \"E1\", \"E2\", \"E3\", \"E4\", \"E5\", \"N1\", \"N2\", \"N3\", \"N4\", \"N5\", \"O1\", \"O2\", \"O3\", \"O4\", \"O5\")\nx <- data[complete.cases(data[, vars]), vars]\nefa <- psych::fa(x, nfactors = 5, fm = \"minres\", rotate = \"oblimin\")\nloadings <- unclass(efa$loadings)\ncommunality <- efa$communality\nvariance <- efa$Vaccounted\nfactor_cor <- efa$Phi   # NULL when the factors are uncorrelated\neigenvalues <- eigen(cor(x))$values\n# Sampling adequacy (KMO) and Bartlett's test of sphericity\nR <- cor(x)\nQ <- solve(R)\nA <- -Q / sqrt(outer(diag(Q), diag(Q)))   # anti-image (partial) correlations\noff <- row(R) != col(R)\nkmo <- sum(R[off]^2) / (sum(R[off]^2) + sum(A[off]^2))\nbartlett_chi <- -(nrow(x) - 1 - (2 * ncol(x) + 5) / 6) * log(det(R))\nbartlett_df <- ncol(x) * (ncol(x) - 1) / 2\nbartlett_p <- pchisq(bartlett_chi, bartlett_df, lower.tail = FALSE)\nscree <- data.frame(factor = seq_along(eigenvalues), eigenvalue = eigenvalues)\np_scree <- ggnext(scree, aes(factor, eigenvalue)) +\n  geom_line() +\n  geom_point(size = 3) +\n  geom_hline(yintercept = 1, dash = \"4 4\") +\n  labs(title = \"Scree plot\", x = \"Factor\", y = \"Eigenvalue\") +\n  theme_modern()",
  "warnings": [],
