  "module": "anova_rm",
  "module_version": "1.0.0",
  "title": "Repeated Measures ANOVA",
  "status": "ok",
  "code": "library(car)\nlibrary(ggnext)\n# Repeated measures ANOVA: age8, age10, age12, age14 by sex\nd <- data[complete.cases(data[, c(\"age8\", \"age10\", \"age12\", \"age14\", \"sex\"), drop = FALSE]), , drop = FALSE]\nd$sex <- droplevels(factor(d$sex))\nmeasures <- c(\"age8\", \"age10\", \"age12\", \"age14\")\ndesc <- sapply(d[measures], function(v) c(n = length(v), mean = mean(v), sd = sd(v)))\nwithin <- data.frame(Age = factor(measures, levels = measures))\nfit <- lm(cbind(age8, age10, age12, age14) ~ sex, data = d,\n  contrasts = list(sex = contr.sum))\nrm_anova <- Anova(fit, idata = within, idesign = ~Age, type = 3)\nrm_summary <- summary(rm_anova, multivariate = FALSE)\nlong <- data.frame(Age = factor(rep(measures, each = nrow(d)), levels = measures), value = unlist(d[measures], use.names = FALSE),\n  sex = rep(d$sex, times = length(measures)))\nposthoc <- pairwise.t.test(long$value, long$Age, paired = TRUE, p.adjust.method = \"holm\")\ncells <- aggregate(value ~ Age + sex, data = long, FUN = function(v)\n  c(mean = mean(v), half = qt(0.975, length(v) - 1) * sd(v) / sqrt(length(v))))\ncells <- data.frame(cells[c(\"Age\", \"sex\")], mean = cells$value[, \"mean\"],\n  lower = cells$value[, \"mean\"] - cells$value[, \"half\"], upper = cells$value[, \"mean\"] + cells$value[, \"half\"])\np <- ggnext(cells, aes(Age, mean, color = sex, group = sex)) +\n  geom_line() +\n  geom_point() +\n  geom_errorbar(aes(ymin = lower, ymax = upper), width = 0.1) +\n  labs(title = \"Means by Age\", x = \"Age\", y = \"Mean\") +\n  theme_modern()",
