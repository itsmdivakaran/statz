  "status": "ok",
  "code": "library(MASS)\nlibrary(ggnext)\n# Negative binomial regression: days on ethnicity, sex, age, learner\nd <- data[complete.cases(data[, c(\"days\", \"ethnicity\", \"sex\", \"age\", \"learner\"), drop = FALSE]), , drop = FALSE]\nd$ethnicity <- droplevels(factor(d$ethnicity))\nd$sex <- droplevels(factor(d$sex))\nd$age <- droplevels(factor(d$age))\nd$learner <- droplevels(factor(d$learner))\nfit <- glm.nb(days ~ ethnicity + sex + age + learner, data = d)\ncoefs <- cbind(coef(summary(fit)), confint.default(fit, level = 0.95))\ndispersion <- sum(residuals(fit, type = \"pearson\")^2) / df.residual(fit)\nnull <- update(fit, . ~ 1)\nlr_chi <- as.numeric(2 * (logLik(fit) - logLik(null))); lr_df <- attr(logLik(fit), \"df\") - attr(logLik(null), \"df\")\nresid_df <- data.frame(fitted = fitted(fit), resid = residuals(fit, type = \"deviance\"))\np_resid <- ggnext(resid_df, aes(fitted, resid)) +\n  geom_residual() +\n  labs(title = \"Residuals vs fitted\", x = \"Fitted values\", y = \"Residuals\") +\n  theme_modern()",
