  "status": "ok",
  "code": "library(BayesFactor)\n# Bayesian binomial test: case against p = 0.5\nd <- data\nd$case <- factor(d$case, levels = c(0, 1), labels = c(\"Control\", \"Case\"))\nrscale <- 0.5   # scale of the logistic prior on the log odds\ncounts <- table(d$case)\nbf <- lapply(counts, function(k) proportionBF(y = k, N = sum(counts), p = 0.5, rscale = rscale))\nset.seed(123)\npost <- lapply(bf, function(b) as.numeric(posterior(b, iterations = 10000, progress = FALSE)[, \"p\"]))",
