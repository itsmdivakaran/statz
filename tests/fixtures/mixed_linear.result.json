  "interpretation": {
    "auto_generated": true,
    "text": "A linear mixed model with a random intercept and random slope for days for subject was fitted by REML (180 observations, 18 groups). Significant fixed effects: days. Fixed effects explained 27.9% of the variance; fixed and random effects together 79.9%."
  },
  "notes": [],
  "module": "mixed_linear",
  "module_version": "1.0.0",
  "title": "Linear Mixed Model",
  "status": "ok",
  "code": "library(lmerTest)\nlibrary(ggnext)\n# Linear mixed model: reaction with observations grouped by subject\nd <- data[complete.cases(data[, c(\"reaction\", \"days\", \"subject\"), drop = FALSE]), , drop = FALSE]\nd$subject <- droplevels(factor(d$subject))\nfit <- lmer(reaction ~ days + (1 + days | subject), data = d, REML = TRUE)\ncoefs <- cbind(coef(summary(fit)), confint(fit, parm = \"beta_\", method = \"Wald\", level = 0.95))\nterm_tests <- as.data.frame(anova(fit))  # Type III, Satterthwaite df\nrandom_effects <- as.data.frame(VarCorr(fit))\nr2 <- performance::r2_nakagawa(fit)\nicc <- performance::icc(fit)\nsingular <- isSingular(fit)\nnormality <- shapiro.test(residuals(fit))\nresid_df <- data.frame(fitted = fitted(fit), resid = residuals(fit))\np_resid <- ggnext(resid_df, aes(fitted, resid)) +\n  geom_residual() +\n  labs(title = \"Residuals vs fitted\", x = \"Fitted values\", y = \"Residuals\") +\n  theme_modern()",
  "warnings": [],
