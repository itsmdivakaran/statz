  "title": "Adverse Events Table",
  "status": "ok",
  "code": "library(ggnext)\n# Adverse events by TRT01P: subjects are counted once per event term\nae <- data[complete.cases(data[, c(\"USUBJID\", \"TRT01P\", \"AEDECOD\")]), , drop = FALSE]\narm_n <- c(85, 85, 84)   # subjects treated in each arm (the denominators)\nnames(arm_n) <- c(\"Placebo\", \"Drug 54 mg\", \"Drug 81 mg\")\narms <- names(arm_n)\ncount_subjects <- function(rows) sapply(arms, function(a) length(unique(rows[[\"USUBJID\"]][rows[[\"TRT01P\"]] == a])))\nany_event <- count_subjects(ae)\nn_events <- sapply(arms, function(a) sum(ae$TRT01P == a))\nby_term <- do.call(rbind, lapply(split(ae, ae$AEDECOD), count_subjects))\nby_soc <- do.call(rbind, lapply(split(ae, ae$AEBODSYS), count_subjects))\nterm_soc <- tapply(as.character(ae$AEBODSYS), ae$AEDECOD, function(s) s[1])\n# Each subject's worst severity\nsev_levels <- c(\"MILD\", \"MODERATE\", \"SEVERE\", \"LIFE THREATENING\", \"FATAL\")\nworst <- aggregate(match(as.character(ae$AESEV), sev_levels), list(subject = ae$USUBJID, arm = ae$TRT01P), max)\nby_severity <- do.call(rbind, lapply(seq_along(sev_levels), function(i) sapply(arms, function(a) sum(worst$x == i & worst$arm == a))))\nrownames(by_severity) <- sev_levels\npct_term <- 100 * sweep(by_term, 2, arm_n, \"/\")\n# Risk difference (percentage points) versus the first arm, Wald 95% CI\nz <- qnorm(1 - (1 - 0.95) / 2)\nrisk_diff <- lapply(arms[-1], function(a) {\n  p1 <- by_term[, a] / arm_n[a]; p0 <- by_term[, 1] / arm_n[1]\n  se <- sqrt(p1 * (1 - p1) / arm_n[a] + p0 * (1 - p0) / arm_n[1])\n  100 * cbind(estimate = p1 - p0, lower = p1 - p0 - z * se, upper = p1 - p0 + z * se)\n})\nnames(risk_diff) <- arms[-1]\ntop <- names(sort(rowSums(by_term), decreasing = TRUE))[seq_len(min(nrow(by_term), 15))]\nheat_df <- data.frame(arm = factor(rep(arms, each = length(top)), levels = arms), term = factor(rep(top, length(arms)), levels = rev(top)),\n                      pct = round(as.vector(pct_term[top, arms]), 1))\n# Short term codes on the axis (ggnext clips long axis labels); the table lists the full terms\nheat_df$term <- factor(abbreviate(as.character(heat_df$term), 9), levels = abbreviate(rev(top), 9))\np <- ggnext(heat_df, aes(arm, term, size = pct)) +\n  geom_ae_heatmap() +\n  labs(title = \"Adverse event incidence (%)\", x = \"TRT01P\", y = \"\") +\n  theme_modern()\np <- p + labs(color = \"% of subjects\")",
