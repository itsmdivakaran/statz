  "code": "library(psych)\n# Agreement between rater1 and rater2\nd <- data[complete.cases(data[, c(\"rater1\", \"rater2\"), drop = FALSE]), , drop = FALSE]\nd$rater1 <- droplevels(factor(d$rater1))\nd$rater2 <- droplevels(factor(d$rater2))\ncategories <- union(levels(d$rater1), levels(d$rater2))\nagreement <- table(factor(d$rater1, categories), factor(d$rater2, categories))\npercent_agreement <- 100 * sum(diag(agreement)) / sum(agreement)\nkappa <- cohen.kappa(unclass(agreement), alpha = 0.05)",
