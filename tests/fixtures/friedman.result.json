  "code": "library(ggnext)\n# Friedman test: age8, age10, age12, age14\nd <- data[complete.cases(data[, c(\"age8\", \"age10\", \"age12\", \"age14\")]), c(\"age8\", \"age10\", \"age12\", \"age14\")]\ndesc <- sapply(d, function(v) c(n = length(v), median = median(v), q1 = unname(quantile(v, 0.25)), q3 = unname(quantile(v, 0.75))))\nfriedman <- friedman.test(as.matrix(d))\nkendall_w <- unname(friedman$statistic) / (nrow(d) * (ncol(d) - 1))\nlong <- data.frame(condition = factor(rep(names(d), each = nrow(d)), levels = names(d)), value = unlist(d, use.names = FALSE))\nposthoc <- pairwise.wilcox.test(long$value, long$condition, paired = TRUE,\n  p.adjust.method = \"holm\", exact = FALSE)\np <- ggnext(long, aes(condition, value)) +\n  geom_boxplot() +\n  geom_jitter(width = 0.15, alpha = 0.7) +\n  labs(title = \"Repeated measurements\", x = \"Measurement\", y = \"Value\") +\n  theme_modern()",
