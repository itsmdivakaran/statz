  "module": "surv_cox",
  "module_version": "1.0.0",
  "title": "Cox Regression",
  "status": "ok",
  "code": "library(survival)\nlibrary(ggnext)\n# Cox regression: time on age, ph_ecog, sex\nd <- data[complete.cases(data[, c(\"time\", \"status\", \"age\", \"ph_ecog\", \"sex\"), drop = FALSE]), , drop = FALSE]\nd$sex <- factor(d$sex, levels = c(1, 2), labels = c(\"Male\", \"Female\"))\n# Event = the higher of the two values of status\nstatus_values <- sort(unique(d$status))\nd$event <- as.integer(d$status == status_values[2])\nfit <- coxph(Surv(time, event) ~ age + ph_ecog + sex, data = d, ties = \"efron\")\nfit_summary <- summary(fit)\ncoefs <- cbind(coef(fit_summary)[, c(\"coef\", \"se(coef)\", \"z\", \"Pr(>|z|)\"), drop = FALSE], confint(fit, level = 0.95))\nph <- cox.zph(fit)\n# Hazard ratios with confidence limits\ncoef_df <- data.frame(term = rownames(coefs), est = exp(coefs[, 1]), lower = exp(coefs[, 5]), upper = exp(coefs[, 6]))\ncoef_df$term <- factor(coef_df$term, levels = rev(coef_df$term))\np_coef <- ggnext(coef_df, aes(est, term, ymin = lower, ymax = upper)) +\n  geom_forest(ref = 1) +\n  labs(title = \"Hazard ratios\", x = \"Hazard ratio (95% CI)\") +\n  theme_modern()",
