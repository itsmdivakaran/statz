  "module": "mixed_glmm",
  "module_version": "1.0.0",
  "title": "Generalized Linear Mixed Model",
  "status": "ok",
  "code": "library(lme4)\n# Logistic mixed model: present with observations grouped by id\nd <- data[complete.cases(data[, c(\"present\", \"week\", \"treatment\", \"id\"), drop = FALSE]), , drop = FALSE]\nd$present <- factor(d$present, levels = c(0, 1), labels = c(\"No\", \"Yes\"))\nd$treatment <- droplevels(factor(d$treatment))\nd$id <- droplevels(factor(d$id))\n# Models the probability of the second category: levels(d$present)[2]\nfit <- glmer(present ~ week + treatment + (1 | id), data = d, family = binomial)\ncoefs <- cbind(coef(summary(fit)), confint(fit, parm = \"beta_\", method = \"Wald\", level = 0.95))\nrandom_effects <- as.data.frame(VarCorr(fit))\nsingular <- isSingular(fit)",
