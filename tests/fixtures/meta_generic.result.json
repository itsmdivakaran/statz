  "interpretation": {
    "auto_generated": true,
    "text": "A random-effects meta-analysis of 13 studies gave a pooled ratio of 0.49, 95% CI [0.34, 0.70], z = −3.97, p < .001. Heterogeneity was considerable (I² = 92.2%, Q(12) = 152.28, p < .001). The prediction interval for a new study is [0.15, 1.55]."
  },
  "notes": [],
  "module": "meta_generic",
  "module_version": "1.0.0",
  "title": "Meta-Analysis (Effect Sizes)",
  "status": "ok",
  "code": "library(ggnext)\n# Random-effects meta-analysis (ratio)\nd <- data[complete.cases(data[, c(\"study\", \"log_rr\", \"se\"), drop = FALSE]), , drop = FALSE]\nd$study_label <- make.unique(as.character(d$study))\nes <- metafor::escalc(measure = \"GEN\", yi = log_rr, sei = se, data = d, slab = study_label)   # yi = log ratio, vi = its variance\nmeta <- metafor::rma(yi, vi, data = es, method = \"REML\", test = \"z\", level = 95)\nz <- qnorm(1 - (1 - 0.95) / 2)\nstudies <- data.frame(study = d$study_label, yi = as.numeric(es$yi), se = sqrt(es$vi), weight = as.numeric(weights(meta)))\nstudies$lower <- studies$yi - z * studies$se\nstudies$upper <- studies$yi + z * studies$se\npooled <- predict(meta)   # pooled estimate with confidence and prediction interval\n# Egger's regression test for funnel plot asymmetry\negger <- metafor::regtest(meta, model = \"lm\", predictor = \"sei\")\nforest_df <- data.frame(term = c(studies$study, \"Pooled\"), est = exp(c(studies$yi, pooled$pred)),\n                        lower = exp(c(studies$lower, pooled$ci.lb)), upper = exp(c(studies$upper, pooled$ci.ub)), weight = c(studies$weight, 100))\nforest_df$term <- factor(forest_df$term, levels = rev(forest_df$term))\n# Names are drawn inside the panel, left of the data (ggnext clips long axis labels)\nlabel_pad <- min(0.5, (max(nchar(as.character(forest_df$term))) * 7 + 12) / 500)\nforest_df$label_x <- min(forest_df$lower) / (max(forest_df$upper) / min(forest_df$lower))^(label_pad / (1 - label_pad))\np_forest <- ggnext(forest_df, aes(est, term, ymin = lower, ymax = upper, size = weight)) +\n  geom_forest(ref = 1) +\n  geom_text(aes(x = label_x, y = term, label = term), anchor = \"start\") +\n  scale_x_log10() +\n  labs(title = \"Forest plot\", x = \"Ratio (95% CI)\") +\n  theme(axis_title_y = FALSE, axis_text_y = FALSE, legend_position = \"none\", base = theme_modern())\nse_max <- max(studies$se) * 1.05\nfunnel_lines <- data.frame(x = pooled$pred, y = 0, xend = pooled$pred + c(-1, 1) * z * se_max, yend = se_max)\np_funnel <- ggnext(studies, aes(yi, se)) +\n  geom_segment(aes(x = x, y = y, xend = xend, yend = yend), data = funnel_lines) +\n  geom_vline(xintercept = pooled$pred, dash = \"4 4\") +\n  geom_point(size = 3) +\n  scale_y_reverse() +\n  labs(title = \"Funnel plot\", x = \"Log ratio\", y = \"Standard error\") +\n  theme_modern()",
