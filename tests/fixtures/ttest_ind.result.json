  "module_version": "1.0.0",
  "title": "Independent Samples T-Test",
  "status": "ok",
  "code": "library(effectsize)\nlibrary(car)\nlibrary(ggnext)\n# Independent samples t-test: mpg by am\nd <- subset(data, !is.na(mpg) & !is.na(am))\nd$am <- factor(d$am, levels = c(0, 1), labels = c(\"Automatic\", \"Manual\"))\ndesc <- aggregate(mpg ~ am, data = d, FUN = function(x)\n  c(n = length(x), mean = mean(x), sd = sd(x), se = sd(x) / sqrt(length(x))))\nwelch <- t.test(mpg ~ am, data = d, var.equal = FALSE,\n  alternative = \"two.sided\", conf.level = 0.95)\nes <- cohens_d(mpg ~ am, data = d, ci = 0.95)\nnormality <- tapply(d$mpg, d$am, shapiro.test)\nlevene <- leveneTest(mpg ~ am, data = d, center = median)\np <- ggnext(d, aes(am, mpg)) +\n  geom_boxplot() +\n  geom_jitter(width = 0.15, alpha = 0.7) +\n  labs(title = \"mpg by am\", x = \"Transmission\", y = \"Miles per US gallon\") +\n  theme_modern()",
