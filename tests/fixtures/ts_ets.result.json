  "notes": [],
  "module": "ts_ets",
  "module_version": "1.0.0",
  "title": "Exponential Smoothing",
  "status": "ok",
  "code": "library(ggnext)\n# Exponential smoothing forecast of passengers\nd <- data[!is.na(data$passengers), , drop = FALSE]\nd <- d[order(d$date), , drop = FALSE]   # rows in time order\ny <- ts(d$passengers, frequency = 12, start = c(1949, 1))\ny_train <- head(y, length(y) - 12)\ny_test <- tail(y, 12)\nfit <- forecast::ets(y_train, model = \"ZZZ\", damped = NULL)   # Z = chosen automatically by AICc\nparameters <- fit$par[names(fit$par) %in% c(\"alpha\", \"beta\", \"gamma\", \"phi\")]\nfc <- forecast::forecast(fit, h = 24, level = 95)\nforecast_tbl <- data.frame(time = as.numeric(time(fc$mean)), forecast = as.numeric(fc$mean), lower = as.numeric(fc$lower), upper = as.numeric(fc$upper))\naccuracy_train <- forecast::accuracy(fit)\n# Accuracy on the last 12 observations, which the model did not see\naccuracy_test <- forecast::accuracy(fc, y_test)\n# Ljung-Box test: are the residuals free of autocorrelation?\nlb_lag <- min(24, 10, length(y_train) %/% 5)\nlb_lag <- max(lb_lag, length(parameters) + 1)\nljung_box <- Box.test(residuals(fit), lag = lb_lag, type = \"Ljung-Box\", fitdf = length(parameters))\nplot_df <- rbind(\n  data.frame(time = as.numeric(time(y)), value = as.numeric(y), lower = NA, upper = NA, part = \"Observed\"),\n  data.frame(time = forecast_tbl$time, value = forecast_tbl$forecast, lower = forecast_tbl$lower, upper = forecast_tbl$upper, part = \"Forecast\"))\np_forecast <- ggnext(plot_df, aes(time, value, ymin = lower, ymax = upper, group = part)) +\n  geom_forecast_band() +\n  labs(title = \"Forecast\", x = \"Time\", y = \"Passengers (thousands)\") +\n  theme_modern()\nresid_acf <- with(acf(residuals(fit), plot = FALSE), data.frame(lag = as.numeric(lag) * frequency(y), value = as.numeric(acf)))\nresid_acf <- resid_acf[resid_acf$lag > 0, ]\nresid_acf_limit <- qnorm(0.975) / sqrt(length(residuals(fit)))   # limits expected for white noise\np_residuals <- ggnext(resid_acf, aes(x = lag, y = 0, xend = lag, yend = value)) +\n  geom_segment() +\n  geom_hline(yintercept = resid_acf_limit, dash = \"4 4\") +\n  geom_hline(yintercept = -resid_acf_limit, dash = \"4 4\") +\n  labs(title = \"Residual autocorrelation\", x = \"Lag\", y = \"Autocorrelation\") +\n  theme_modern()",
