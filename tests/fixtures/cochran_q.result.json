  "title": "Cochran's Q Test",
  "status": "ok",
  "code": "# Cochran's Q: drug_a, drug_b, drug_c\nvars <- c(\"drug_a\", \"drug_b\", \"drug_c\")\nd <- data[complete.cases(data[, c(\"drug_a\", \"drug_b\", \"drug_c\"), drop = FALSE]), , drop = FALSE]\nd$drug_a <- factor(d$drug_a, levels = c(0, 1), labels = c(\"No response\", \"Response\"))\nd$drug_b <- factor(d$drug_b, levels = c(0, 1), labels = c(\"No response\", \"Response\"))\nd$drug_c <- factor(d$drug_c, levels = c(0, 1), labels = c(\"No response\", \"Response\"))\n# 1 = second category of each variable, 0 = first\nx <- sapply(d[vars], function(v) as.integer(v) - 1L)\nk <- ncol(x); col_tot <- colSums(x); row_tot <- rowSums(x); N <- sum(x)\nq <- (k - 1) * (k * sum(col_tot^2) - N^2) / (k * N - sum(row_tot^2))\ncochran <- list(statistic = q, df = k - 1, p.value = pchisq(q, k - 1, lower.tail = FALSE))\npair_idx <- t(combn(vars, 2))\npair_p <- apply(pair_idx, 1, function(p) mcnemar.test(table(factor(x[, p[1]], 0:1), factor(x[, p[2]], 0:1)))$p.value)\nposthoc <- data.frame(var1 = pair_idx[, 1], var2 = pair_idx[, 2], p = pair_p, p_adj = p.adjust(pair_p, \"holm\"))",
