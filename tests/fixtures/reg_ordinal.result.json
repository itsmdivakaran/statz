  "module": "reg_ordinal",
  "module_version": "1.0.0",
  "title": "Ordinal Regression",
  "status": "ok",
  "code": "library(MASS)\nlibrary(nnet)\n# Ordinal regression: satisfaction on influence, type, contact\nd <- data[complete.cases(data[, c(\"satisfaction\", \"influence\", \"type\", \"contact\"), drop = FALSE]), , drop = FALSE]\nd$satisfaction <- factor(d$satisfaction, levels = c(1, 2, 3), labels = c(\"Low\", \"Medium\", \"High\"))\nd$influence <- droplevels(factor(d$influence))\nd$type <- droplevels(factor(d$type))\nd$contact <- droplevels(factor(d$contact))\nd$satisfaction <- factor(d$satisfaction, ordered = TRUE)\nfit <- polr(satisfaction ~ influence + type + contact, data = d, Hess = TRUE)\nct <- coef(summary(fit))\ncoefs <- cbind(ct, p = 2 * pnorm(abs(ct[, 3]), lower.tail = FALSE),\n  lower = ct[, 1] - qnorm(1 - (1 - 0.95) / 2) * ct[, 2], upper = ct[, 1] + qnorm(1 - (1 - 0.95) / 2) * ct[, 2])\nnull <- polr(satisfaction ~ 1, data = d)\nlr_chi <- deviance(null) - deviance(fit); lr_df <- length(coef(fit))\nr2_mcfadden <- 1 - deviance(fit) / deviance(null)\n# Proportional odds check: likelihood-ratio test against a multinomial model\nmulti <- multinom(satisfaction ~ influence + type + contact, data = d, trace = FALSE)\npo_chi <- deviance(fit) - deviance(multi); po_df <- multi$edf - fit$edf\npo_p <- pchisq(po_chi, po_df, lower.tail = FALSE)",
