  "module": "anova_factorial",
  "module_version": "1.0.0",
  "title": "Factorial ANOVA / ANCOVA",
  "status": "ok",
  "code": "library(car)\nlibrary(emmeans)\nlibrary(ggnext)\n# ANOVA: len by supp, dose\nd <- data[complete.cases(data[, c(\"len\", \"supp\", \"dose\"), drop = FALSE]), , drop = FALSE]\nd$supp <- droplevels(factor(d$supp))\nd$dose <- droplevels(factor(d$dose))\nfit <- lm(len ~ supp + dose + supp:dose, data = d,\n  contrasts = list(supp = contr.sum, dose = contr.sum))\nanova_table <- as.data.frame(Anova(fit, type = 3))\nanova_table <- anova_table[rownames(anova_table) != \"(Intercept)\", ]\nss_resid <- anova_table[\"Residuals\", \"Sum Sq\"]\nanova_table$eta_p <- anova_table$`Sum Sq` / (anova_table$`Sum Sq` + ss_resid)\nanova_table[\"Residuals\", \"eta_p\"] <- NA\nemm_1 <- emmeans(fit, ~ supp, level = 0.95)\nposthoc_1 <- pairs(emm_1, adjust = \"tukey\")\nemm_2 <- emmeans(fit, ~ dose, level = 0.95)\nposthoc_2 <- pairs(emm_2, adjust = \"tukey\")\nnormality <- shapiro.test(residuals(fit))\nlevene <- leveneTest(len ~ supp * dose, data = d, center = median)\n# Cell means with t-based confidence intervals\ncells <- aggregate(len ~ supp + dose, data = d, FUN = function(v)\n  c(mean = mean(v), half = qt(1 - (1 - 0.95) / 2, length(v) - 1) * sd(v) / sqrt(length(v))))\ncells <- data.frame(cells[c(\"supp\", \"dose\")], mean = cells[[3]][, \"mean\"],\n  lower = cells[[3]][, \"mean\"] - cells[[3]][, \"half\"],\n  upper = cells[[3]][, \"mean\"] + cells[[3]][, \"half\"])\np_means <- ggnext(cells, aes(supp, mean, color = dose, group = dose)) +\n  geom_line() +\n  geom_point() +\n  geom_errorbar(aes(ymin = lower, ymax = upper), width = 0.1) +\n  labs(title = \"Mean len\", x = \"Supplement\", y = \"Tooth length\") +\n  theme_modern()",
