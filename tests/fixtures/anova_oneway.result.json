  "interpretation": {
    "auto_generated": true,
    "text": "A one-way ANOVA showed a significant effect of group on weight, F(2, 27) = 4.85, p = .016, η² = 0.26. Welch's test, which does not assume equal variances, gave F(2, 17.13) = 5.18, p = .017. Tukey post-hoc comparisons showed significant differences for trt2 vs trt1."
  },
  "notes": [],
  "module": "anova_oneway",
  "module_version": "1.1.0",
  "title": "One-Way ANOVA",
  "status": "ok",
  "code": "library(effectsize)\nlibrary(car)\nlibrary(ggnext)\n# One-way ANOVA: weight by group\nd <- subset(data, !is.na(weight) & !is.na(group))\nd$group <- droplevels(factor(d$group))\ndesc <- aggregate(weight ~ group, data = d, FUN = function(x)\n  c(n = length(x), mean = mean(x), sd = sd(x), se = sd(x) / sqrt(length(x))))\nfit <- aov(weight ~ group, data = d)\nanova_table <- summary(fit)[[1]]\nwelch <- oneway.test(weight ~ group, data = d, var.equal = FALSE)\neta <- eta_squared(fit, partial = FALSE, ci = 0.95, alternative = \"two.sided\")\nomega <- omega_squared(fit, partial = FALSE, ci = 0.95, alternative = \"two.sided\")\nposthoc <- TukeyHSD(fit, conf.level = 0.95)\nnormality <- shapiro.test(residuals(fit))\nlevene <- leveneTest(weight ~ group, data = d, center = median)\nd_ci <- do.call(rbind, lapply(split(d$weight, d$group), function(v) {\n  v <- v[!is.na(v)]; m <- mean(v); h <- qt(0.975, length(v) - 1) * sd(v) / sqrt(length(v))\n  data.frame(mean = m, lower = m - h, upper = m + h)\n}))\nd_ci$group <- factor(rownames(d_ci), levels = rownames(d_ci))\np <- ggnext(d_ci, aes(group, mean, ymin = lower, ymax = upper)) +\n  geom_pointrange() +\n  labs(title = \"weight by group\", x = \"Condition\", y = \"Dried weight (g)\") +\n  theme_modern()",
